# Browser-safe deployment configuration. Never put private keys here.
# Consensus v0.6 development/testing runs on Studio Next (preset `studioDevnet`,
# canonical RPC https://studio-dev.genlayer.com/api, chain id 61997).
NEXT_PUBLIC_GENLAYER_NETWORK=studioDevnet
NEXT_PUBLIC_HORKIOS_CONTRACT_ADDRESS=0x5306c0f759dDD670452655f00a8181a54b007F69
NEXT_PUBLIC_FEE_RECIPIENT=
# Optional: allow signing when the live fee-policy quote is a `mismatch`
# (default false — ordinary flows fail closed and re-estimate).
NEXT_PUBLIC_ALLOW_UNVERIFIED_FEES=false

# Deployment only. Keep the real value in a local, ignored .env file.
DEPLOYER_PRIVATE_KEY=
FEE_RECIPIENT=
PRIVATE_KEY=

# Studio Next (studio-dev) — normally supplied by the matching RC SDK preset
# Chain Name: GenLayer Studio Devnet
# Chain ID: 61997
# RPC URL: https://studio-dev.genlayer.com/api
# Currency Symbol: GEN
# Explorer: https://explorer-studio-dev.genlayer.com/

# Bradbury Testnet — add to wallet manually
# Chain Name: GenLayer Bradbury Testnet
# Chain ID: 4221
# RPC URL: https://rpc-bradbury.genlayer.com
# Currency Symbol: GEN
# Block Explorer: https://explorer-bradbury.genlayer.com/
